{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "es2022",
            "DOM",
            "DOM.iterable",
            "esnext"
        ],
        "module": "esnext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "jsx": "react-jsx",
        /* Linting */
        "strict": true,
        "allowJs": true,
        "checkJs": false,
        "isolatedModules": true,
        // "esModuleInterop": true,
    },
    "include": [
        "src"
    ],
    // "references": [{ "path": "./tsconfig.node.json" }]
}